# ==============================================================================
# EngineerOS — Server Environment Configuration Template
# ==============================================================================

# Application & Runtime
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CLIENT_URL=http://localhost:3000

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/engineeros?replicaSet=rs0
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_ACCESS_SECRET=your-secure-jwt-access-secret-at-least-32-chars-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your-secure-jwt-refresh-secret-at-least-32-chars-long
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=your-cookie-signing-secret-key-32-chars

# Code Execution (Judge0)
# Options: 'mock' (offline local runner) or 'judge0' (external/container Judge0 API)
CODE_EXEC_PROVIDER=mock
JUDGE0_API_URL=http://localhost:2358
JUDGE0_API_KEY=

# AI LLM Provider
# Options: 'mock' (offline local generator) or 'anthropic'
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022

# Storage Provider
# Options: 'local' or 's3'
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email Provider
# Options: 'console' (prints to stdout) or 'ses' / 'smtp'
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@engineeros.dev

# Rate Limiting & Concurrency
RATE_LIMIT_GLOBAL_MAX=120
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_CODE_EXEC_MAX=15
RATE_LIMIT_AI_MAX=10

# Logging
LOG_LEVEL=info
