{
  "name": "engineeros-server",
  "version": "1.0.0",
  "description": "EngineerOS API and Worker Backend",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:worker": "node src/worker.js",
    "dev:api": "node --watch src/server.js",
    "dev:worker": "node --watch src/worker.js",
    "build": "node -e \"console.log('Server is native ES Modules - ready for deployment')\"",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed": "node src/utils/seed.js"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "bullmq": "^5.41.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "nanoid": "^5.1.3",
    "opossum": "^8.5.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "rate-limit-redis": "^4.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "mongodb-memory-server": "^10.1.4",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "vitest": "^3.0.7"
  }
}
